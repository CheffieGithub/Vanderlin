#define TRANSFORM_IN_HAND "in_hands"
#define TRANSFORM_ON_BELT "on_belt"
#define TRANSFORM_ON_BACK "on_back"
#define TRANSFORM_WIELDED "wielded"
#define TRANSFORM_ALT_GRIP "alt_grip"

// ========== Transformation values ==========

/// Amount to shrink the icon by
#define SHRINK "shrink"

// Pixel offset when facing each direction in x
/// X offset facing north
#define NORTH_X "nx"
/// X offset facing east
#define EAST_X "ex"
/// X offset facing south
#define SOUTH_X "sx"
/// X offset facing west
#define WEST_X "wx"

// Pixel offset when facing each direction in y
/// Y offset facing north
#define NORTH_Y "ny"
/// Y offset facing east
#define EAST_Y "ey"
/// Y offset facing south
#define SOUTH_Y "sy"
/// Y offset facing west
#define WEST_Y "wy"

// Turn of the icon_state in degrees per direction
/// Degrees to turn when facing north
#define NORTH_TURN "nturn"
/// Degrees to turn when facing east
#define EAST_TURN "eturn"
/// Degrees to turn when facing south
#define SOUTH_TURN "sturn"
/// Degrees to turn when facing west
#define WEST_TURN "wturn"

// Direction to flip the sprite in per direction
/// Direction to flip the sprite when facing north
#define NORTH_FLIP "nflip"
/// Direction to flip the sprite when facing east
#define EAST_FLIP "eflip"
/// Direction to flip the sprite when facing south
#define SOUTH_FLIP "sflip"
/// Direction to flip the sprite when facing west
#define WEST_FLIP "wflip"

#define HORIZONTAL NORTH
#define VERTICAL EAST

// Whether the direction renders above the mob, Boolean
/// If the sprite layers above when facing north
#define NORTH_ABOVE "northabove"
/// If the sprite layers above when facing east
#define EAST_ABOVE "eastabove"
/// If the sprite layers above when facing south
#define SOUTH_ABOVE "southabove"
/// If the sprite layers above when facing west
#define WEST_ABOVE "westabove"
